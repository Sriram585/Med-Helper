{
    "builds": [
        {
            "src": "main.py",
            "use": "@vercel/python"
        }
    ],
    "rewrites": [
        {
            "source": "/analyze",
            "destination": "/main.py"
        },
        {
            "source": "/chat",
            "destination": "/main.py"
        },
        {
            "source": "/generate/(.*)",
            "destination": "/main.py"
        },
        {
            "source": "/analyze_report",
            "destination": "/main.py"
        },
        {
            "source": "/docs",
            "destination": "/main.py"
        },
        {
            "source": "/openapi.json",
            "destination": "/main.py"
        }
    ]
}